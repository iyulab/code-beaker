<Project>

  <!-- 모든 프로젝트의 패키지 버전은 여기 한 곳에 있다. csproj의 PackageReference는 이름만 적는다. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!--
      전이 의존성 핀은 켜지 않는다. 켜면 여기 적힌 패키지가 전이로 들어오는 프로젝트의 nuspec에
      직접 의존성으로 추가돼(예: CodeBeaker.Runtimes가 Core를 통해 받는 Serilog·Redis가 Runtimes의
      의존성으로 올라감) 소비자에게 보이는 패키지 계약이 바뀐다. 이 리포는 라이브러리를 발행한다.
    -->
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Runtime / library -->
  <ItemGroup>
    <PackageVersion Include="Docker.DotNet.Enhanced" Version="4.3.3" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="StackExchange.Redis" Version="3.1.31" />
  </ItemGroup>

  <!-- API server -->
  <ItemGroup>
    <PackageVersion Include="prometheus-net.AspNetCore" Version="8.2.1" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <!-- Tests -->
  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="6.0.0" />
    <!-- FluentAssertions stays on the 6.x line deliberately: 8.0.0 moved to a paid
         commercial license, so upgrading is a licensing decision rather than
         routine maintenance. Tooling that reports "outdated" cannot see that. -->
    <PackageVersion Include="FluentAssertions" Version="6.12.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>

  <!-- Samples / benchmarks -->
  <ItemGroup>
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="DotNetEnv" Version="3.0.0" />
    <PackageVersion Include="OpenAI" Version="2.0.0-beta.11" />
    <PackageVersion Include="Websocket.Client" Version="5.1.2" />
  </ItemGroup>

</Project>
